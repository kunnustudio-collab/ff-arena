# TOURNAMENT X - Master Platform Environment Configuration

# Service Ports & Hosts
BACKEND_PORT=5000
ADMIN_PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/tournament_x_db
POSTGRES_DB=tournament_x_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Redis Configuration (Redis 7)
REDIS_URL=redis://localhost:6379

# Production Safety Gates
DEMO_MODE=true
PRODUCTION_FINANCIAL_MODE=false

# Branding
BRAND_NAME=Tournament X
BRAND_TAGLINE="Compete. Climb. Win."
BRAND_ACCENT_COLOR="#00F0FF"

# Authentication & JWT Secrets (Minimum 32 random characters)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_entropy_key!
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_entropy!
ADMIN_JWT_SECRET=super_secret_admin_jwt_key_at_least_32_characters_enterprise!

# Payment Gateway (MOCK / RAZORPAY / CASHFREE)
PAYMENT_PROVIDER=MOCK
PAYMENT_KEY_ID=placeholder_payment_key
PAYMENT_KEY_SECRET=placeholder_payment_secret
PAYMENT_WEBHOOK_SECRET=placeholder_webhook_secret

# Payout / Withdrawal Gateway
PAYOUT_PROVIDER=MOCK
PAYOUT_KEY_ID=placeholder_payout_key
PAYOUT_KEY_SECRET=placeholder_payout_secret

# KYC Verification Provider (MOCK / SUREPASS / KARZA)
KYC_PROVIDER=MOCK
KYC_API_KEY=placeholder_kyc_key

# Limits and Compliance
MIN_DEPOSIT_INR=50
MAX_DEPOSIT_INR=10000
MIN_WITHDRAWAL_INR=100
MAX_WITHDRAWAL_INR=25000
WITHDRAWAL_FEE_PERCENT=2
PLATFORM_FEE_PERCENT=10
MIN_AGE_YEARS=18
GEO_RESTRICTED_STATES=Andhra Pradesh,Assam,Nagaland,Odisha,Sikkim,Telangana

# Tournament X Production Environment Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=*

# Demo & Financial Safety Gates
# In DEMO_MODE=true, payments and KYC simulate approval for testing/app review
DEMO_MODE=true
# Real-money payouts/charges require PRODUCTION_FINANCIAL_MODE=true
PRODUCTION_FINANCIAL_MODE=false

# Platform Branding
BRAND_NAME=Tournament X
BRAND_TAGLINE="Compete. Climb. Win."
BRAND_ACCENT_COLOR="#00F0FF"

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tournament_x_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tournament_x_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Redis Cache & Queues
REDIS_URL=redis://localhost:6379

# Security & Tokens
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_entropy_key!
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_entropy!
ADMIN_JWT_SECRET=super_secret_admin_jwt_key_at_least_32_characters_enterprise!
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# File Upload / Storage (S3 Compatible or Local)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=tournament-x-assets
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Payment Gateway Configuration (Pluggable: MOCK | RAZORPAY | CASHFREE)
PAYMENT_PROVIDER=MOCK
PAYMENT_KEY_ID=test_payment_key_id
PAYMENT_KEY_SECRET=test_payment_key_secret
PAYMENT_WEBHOOK_SECRET=test_payment_webhook_secret_signature

# Payout / Withdrawal Provider (UPI & IMPS)
PAYOUT_PROVIDER=MOCK
PAYOUT_KEY_ID=test_payout_key_id
PAYOUT_KEY_SECRET=test_payout_key_secret

# KYC Verification Provider (Pluggable: MOCK | SUREPASS | KARZA)
KYC_PROVIDER=MOCK
KYC_API_KEY=test_kyc_api_key

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=firebase_server_cloud_messaging_key
FCM_PROJECT_ID=tournament-x-firebase

# Responsible Play & Financial Limits
MIN_DEPOSIT_INR=50
MAX_DEPOSIT_INR=10000
MIN_WITHDRAWAL_INR=100
MAX_WITHDRAWAL_INR=25000
DAILY_WITHDRAWAL_LIMIT_INR=50000
WITHDRAWAL_FEE_PERCENT=2
PLATFORM_FEE_PERCENT=10
MIN_AGE_YEARS=18
GEO_RESTRICTED_STATES=Andhra Pradesh,Assam,Nagaland,Odisha,Sikkim,Telangana

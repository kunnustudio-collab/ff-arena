NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=*

DEMO_MODE=true
PRODUCTION_FINANCIAL_MODE=false

BRAND_NAME=Tournament X
BRAND_TAGLINE="Compete. Climb. Win."
BRAND_ACCENT_COLOR="#00F0FF"

DATABASE_URL=postgres://postgres:postgres@localhost:5432/tournament_x_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tournament_x_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

REDIS_URL=redis://localhost:6379

JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_entropy_key!
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_entropy!
ADMIN_JWT_SECRET=super_secret_admin_jwt_key_at_least_32_characters_enterprise!
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

PAYMENT_PROVIDER=MOCK
PAYMENT_KEY_ID=test_payment_key_id
PAYMENT_KEY_SECRET=test_payment_key_secret
PAYMENT_WEBHOOK_SECRET=test_payment_webhook_secret_signature

PAYOUT_PROVIDER=MOCK
PAYOUT_KEY_ID=test_payout_key_id
PAYOUT_KEY_SECRET=test_payout_key_secret

KYC_PROVIDER=MOCK
KYC_API_KEY=test_kyc_api_key

FCM_SERVER_KEY=firebase_server_cloud_messaging_key
FCM_PROJECT_ID=tournament-x-firebase

MIN_DEPOSIT_INR=50
MAX_DEPOSIT_INR=10000
MIN_WITHDRAWAL_INR=100
MAX_WITHDRAWAL_INR=25000
DAILY_WITHDRAWAL_LIMIT_INR=50000
WITHDRAWAL_FEE_PERCENT=2
PLATFORM_FEE_PERCENT=10
MIN_AGE_YEARS=18
GEO_RESTRICTED_STATES=Andhra Pradesh,Assam,Nagaland,Odisha,Sikkim,Telangana
